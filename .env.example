# 本地运行可复制为 .env；云端（Render）在服务环境变量里设置
PORT=8787
HOST=127.0.0.1
TRUST_PROXY=1
# local（本机反代）或 render（平台反代，Render 上自动）
PROXY_MODE=local
ALLOWED_ORIGINS=
REPORT_LIMIT_PER_MIN=30
READ_LIMIT_PER_MIN=120
AUTH_FAIL_LIMIT_PER_MIN=10
BTC_TTL_SEC=30
# 云端：data/tokens.json 不存在时使用，JSON {botId: sha256hex}，由 `node bin/office-admin.js env-hashes` 生成
OFFICE_TOKEN_HASHES=
