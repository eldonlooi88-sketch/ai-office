#!/usr/bin/env bash
# 用法: office-report <bot> <状态> "<任务描述>"
# 配置: 环境变量 OFFICE_URL / OFFICE_TOKEN（或 OFFICE_TOKEN_<BOT>），或 ~/.office-report 文件:
#   OFFICE_URL=https://ai-office-vk1v.onrender.com
#   OFFICE_TOKEN_CODEX=ofc_xxx      # 每个 Bot 一个 Token
set -euo pipefail
CONF="${OFFICE_REPORT_CONFIG:-$HOME/.office-report}"
if [ -f "$CONF" ]; then
  while IFS='=' read -r k v; do
    [[ "$k" =~ ^[A-Z0-9_]+$ ]] || continue
    [ -z "${!k:-}" ] && export "$k=$v"
  done < "$CONF"
fi
if [ $# -lt 2 ]; then
  echo '用法: office-report <bot> <状态> "<任务>"' >&2
  echo '状态: working/工作中 thinking/思考中 browsing/浏览网页 help/需要帮助 idle/空闲 done/已完成' >&2
  exit 2
fi
BOT="$1"; STATUS="$2"; TASK="${3:-}"
URL="${OFFICE_URL:-https://ai-office-vk1v.onrender.com}"
VAR="OFFICE_TOKEN_$(echo "$BOT" | tr '[:lower:]-' '[:upper:]_')"
TOKEN="${!VAR:-${OFFICE_TOKEN:-}}"
[ -z "$TOKEN" ] && { echo "缺少 Token：请设置 $VAR 或 OFFICE_TOKEN" >&2; exit 2; }
esc() { local s; s=$(printf '%s' "$1" | tr '\n\r\t' '   ' | tr -d '\000-\037\177'); s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/ }"; s="${s//$'\r'/ }"; s="${s//$'\t'/ }"; printf '%s' "$s"; }
BODY=$(printf '{"bot":"%s","status":"%s","task":"%s"}' "$(esc "$BOT")" "$(esc "$STATUS")" "$(esc "$TASK")")
RESP=$(curl -sS -m 15 -w '\n%{http_code}' -X POST "${URL%/}/api/report" \
  -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' --data-binary "$BODY")
CODE="${RESP##*$'\n'}"; OUT="${RESP%$'\n'*}"
if [ "$CODE" = "200" ]; then echo "✓ 已上报: $OUT"; else echo "✗ 上报失败 (HTTP $CODE): $OUT" >&2; exit 1; fi
